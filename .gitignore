# Python bytecode and local tooling
__pycache__/
*.py[cod]

# PyInstaller build artifacts and packaged executables
# Keep generated files out of version control, except executables.
build/*
!build/**/
!build/**/*.exe
dist/*
!dist/**/
!dist/**/*.exe

# Local backups and workspace-specific agent configuration
Backup/*
!Backup/**/
!Backup/**/*.exe
.agents/
